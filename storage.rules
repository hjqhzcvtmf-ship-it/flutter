rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Profile images: public read, authenticated write
    match /profile_images/{imageId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Membership application images: public read, written by Cloud Functions (Admin SDK)
    // Client writes blocked; Admin SDK bypasses these rules
    match /membership_applications/{userId}/{imageId} {
      allow read: if true;
      allow write: if false;
    }

    // Event images: public read, authenticated write
    match /event_images/{imageId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // General uploads: public read, authenticated write with size limit
    match /tek-nightclub-uploads/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024;
    }

    // Stories: 24h photo posts.
    // Storage rule is permissive (signed-in + image + size). Ownership is
    // enforced at the Firestore stories collection layer — a story file
    // that's never referenced by a Firestore doc is orphaned and harmless,
    // and the Firestore rule gates on auth.token.referralCode == userCode
    // for the doc create.
    //
    // Rationale: gating the storage rule on the custom claim too creates a
    // brittle dependency on token-refresh timing. Users whose local token
    // hasn't picked up the freshly-set claim would hit unauthorized errors
    // even when they're legitimately uploading.
    match /stories/{userCode}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // Chat photo messages.
    // Path is chat_photos/{chatId}/{filename} where chatId is derived from
    // participant referralCodes. Any signed-in user can write images here;
    // the corresponding Firestore message rule enforces senderUid == auth.uid
    // so an orphaned image can't be referenced in a message under a different
    // sender's identity.
    match /chat_photos/{chatId}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // Default deny for any other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
